# =============================================================================
# AI-Powered Job Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ─── APPLICATION ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-secrets-manager
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── DATABASE ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobplatform
POSTGRES_USER=jobplatform
POSTGRES_PASSWORD=jobplatform_dev_password
DATABASE_URL=postgresql+asyncpg://jobplatform:jobplatform_dev_password@localhost:5432/jobplatform

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ─── KAFKA (Redpanda) ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=job-platform-consumers
KAFKA_AUTO_OFFSET_RESET=earliest

# ─── QDRANT (Vector DB) ──────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_JOBS=job_embeddings
QDRANT_COLLECTION_USERS=user_embeddings
QDRANT_COLLECTION_SKILLS=skill_embeddings

# ─── ELASTICSEARCH ───────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic_dev_password
ELASTICSEARCH_INDEX_JOBS=jobs

# ─── MINIO (Object Storage) ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_RESUMES=resumes
MINIO_BUCKET_LOGOS=company-logos
MINIO_BUCKET_REPORTS=reports
MINIO_SECURE=false

# ─── LLM PROVIDERS ───────────────────────────────────────────────────────────
# Default: ollama (free, local). Set others for cloud providers.
LLM_DEFAULT_PROVIDER=ollama
LLM_TEMPERATURE=0.1

# Ollama (local - runs on your machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Cohere
COHERE_API_KEY=your-cohere-key-here

# ─── EMBEDDING MODELS ────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# ─── JOB SOURCES / APIs ──────────────────────────────────────────────────────
# Adzuna (https://developer.adzuna.com/)
ADZUNA_API_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key
ADZUNA_COUNTRY=in

# Greenhouse (no auth required for job boards)
GREENHOUSE_ENABLED=true

# Lever (no auth required for job boards)
LEVER_ENABLED=true

# Indeed scraping (httpx + BeautifulSoup)
INDEED_SCRAPING_ENABLED=true

# Naukri scraping
NAUKRI_SCRAPING_ENABLED=true

# ─── PROXY CONFIGURATION ─────────────────────────────────────────────────────
PROXY_ENABLED=false
PROXY_URL=http://proxy:port
# BrightData proxy (optional)
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# ─── PLAYWRIGHT (Optional - for JS-heavy sites) ───────────────────────────────
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ─── NOTIFICATIONS ───────────────────────────────────────────────────────────
# SendGrid Email
SENDGRID_API_KEY=SG.your-sendgrid-key-here
SENDGRID_FROM_EMAIL=noreply@yourplatform.com
SENDGRID_FROM_NAME=Job Intelligence Platform

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhooks/telegram

# WhatsApp Business API (via Twilio or Meta)
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Webhook HMAC signing
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# ─── AUTHENTICATION ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-32-chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth2 Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ─── EXTERNAL SERVICES ───────────────────────────────────────────────────────
# Google Search API (for company domain discovery)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# WHOIS lookup proxy
WHOIS_TIMEOUT=10

# 2Captcha (for CAPTCHA solving, optional)
TWOCAPTCHA_API_KEY=

# ─── RATE LIMITING ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
SCRAPER_RATE_LIMIT_PER_DOMAIN=2  # requests per second

# ─── ML MODELS ───────────────────────────────────────────────────────────────
ML_MODELS_PATH=./ml/models
SCAM_DETECTOR_MODEL_PATH=./ml/models/scam_detector.pkl
SKILL_EXTRACTOR_MODEL=en_core_web_sm
SALARY_ESTIMATOR_MODEL_PATH=./ml/models/salary_estimator.pkl

# ─── MLFLOW ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=job-platform-models

# ─── OBSERVABILITY ───────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=job-platform

# ─── SCHEDULER ───────────────────────────────────────────────────────────────
COLLECTION_SCHEDULE_CRON="0 */6 * * *"   # Every 6 hours
DEDUP_SCHEDULE_CRON="*/30 * * * *"       # Every 30 minutes
EMBEDDING_BATCH_SCHEDULE="0 * * * *"    # Every hour

# ─── FEATURE FLAGS ───────────────────────────────────────────────────────────
FEATURE_SCAM_DETECTION=true
FEATURE_AUTHENTICITY_CHECK=true
FEATURE_SKILL_EXTRACTION=true
FEATURE_SALARY_ESTIMATION=true
FEATURE_EMBEDDINGS=true
FEATURE_RECOMMENDATIONS=true
FEATURE_NOTIFICATIONS=true
FEATURE_FEEDBACK_LEARNING=false  # Requires training infrastructure
