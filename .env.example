# =============================================================================
# AI-Powered Job Intelligence Platform — Environment Configuration
# High-Capacity Edition: batch processing, 11 collectors, 60-min cadence
# Copy this file to .env and fill in your values
# =============================================================================

# ─── APPLICATION ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-secrets-manager
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── DATABASE ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobplatform
POSTGRES_USER=jobplatform
POSTGRES_PASSWORD=jobplatform_dev_password
DATABASE_URL=postgresql+asyncpg://jobplatform:jobplatform_dev_password@localhost:5432/jobplatform

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ─── KAFKA (Redpanda) — HIGH-THROUGHPUT TUNING ───────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=job-platform-consumers
KAFKA_AUTO_OFFSET_RESET=earliest

# Partition counts per topic (applied when topics are re-created)
KAFKA_PARTITIONS_RAW=32
KAFKA_PARTITIONS_CLEANED=16
KAFKA_PARTITIONS_DEDUP=16
KAFKA_PARTITIONS_ENRICHED=16
KAFKA_PARTITIONS_VERIFIED=8
KAFKA_REPLICATION_FACTOR=1

# Producer batching & concurrency
KAFKA_BATCH_SIZE=500
KAFKA_LINGER_MS=20
KAFKA_SEND_CONCURRENCY=50
KAFKA_COMPRESSION=none

# ─── QDRANT (Vector DB) ──────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_JOBS=job_embeddings
QDRANT_COLLECTION_USERS=user_embeddings
QDRANT_COLLECTION_SKILLS=skill_embeddings

# ─── ELASTICSEARCH ───────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic_dev_password
ELASTICSEARCH_INDEX_JOBS=jobs

# ─── MINIO (Object Storage) ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_RESUMES=resumes
MINIO_BUCKET_LOGOS=company-logos
MINIO_BUCKET_REPORTS=reports
MINIO_SECURE=false

# ─── LLM PROVIDERS ───────────────────────────────────────────────────────────
LLM_DEFAULT_PROVIDER=ollama
LLM_TEMPERATURE=0.1

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

COHERE_API_KEY=your-cohere-key-here

# ─── EMBEDDING MODELS ────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# ─── COLLECTOR — SOURCE TOGGLES ──────────────────────────────────────────────
# Toggle individual collectors on/off
COLLECTOR_ADZUNA_ENABLED=true
COLLECTOR_GREENHOUSE_ENABLED=true
COLLECTOR_LEVER_ENABLED=true
COLLECTOR_WORKDAY_ENABLED=true
COLLECTOR_INDEED_ENABLED=true
COLLECTOR_NAUKRI_ENABLED=true
COLLECTOR_LINKEDIN_ENABLED=true
COLLECTOR_RSS_ENABLED=true
COLLECTOR_GOVERNMENT_ENABLED=true
COLLECTOR_COMPANY_CAREERS_ENABLED=true
COLLECTOR_MANUAL_ENABLED=true

# Adzuna (https://developer.adzuna.com/)
ADZUNA_API_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key
ADZUNA_COUNTRY=in

# ─── COLLECTOR — RATE LIMIT / CAPACITY ───────────────────────────────────────
# Default per-collector semaphore limits (concurrent HTTP requests per source)
COLLECTOR_MAX_CONCURRENCY_PER_SOURCE=20
COLLECTOR_ADAPTIVE_RATE=true

# Per-collector HTTP limits per run (optional overrides)
ADZUNA_REQUESTS_PER_RUN=500
GREENHOUSE_REQUESTS_PER_RUN=400
LEVER_REQUESTS_PER_RUN=300
INDEED_REQUESTS_PER_RUN=300
NAUKRI_REQUESTS_PER_RUN=200

# ─── PROXY / FINGERPRINTING ──────────────────────────────────────────────────
PROXY_ENABLED=false
PROXY_URL=http://proxy:port
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ─── NOTIFICATIONS ───────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-key-here
SENDGRID_FROM_EMAIL=noreply@yourplatform.com
SENDGRID_FROM_NAME=Job Intelligence Platform

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhooks/telegram

WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# ─── AUTHENTICATION ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-32-chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ─── EXTERNAL SERVICES ───────────────────────────────────────────────────────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
WHOIS_TIMEOUT=10
TWOCAPTCHA_API_KEY=

# ─── RATE LIMITING ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=5000
SCRAPER_RATE_LIMIT_PER_DOMAIN=10

# ─── ML MODELS ───────────────────────────────────────────────────────────────
ML_MODELS_PATH=./ml/models
SCAM_DETECTOR_MODEL_PATH=./ml/models/scam_detector.pkl
SKILL_EXTRACTOR_MODEL=en_core_web_sm
SALARY_ESTIMATOR_MODEL_PATH=./ml/models/salary_estimator.pkl

# ─── MLFLOW ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=job-platform-models

# ─── OBSERVABILITY ───────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=job-platform

# ─── SCHEDULER / COLLECTION CADENCE — HIGH-CAPACITY EDITION ──────────────────
# Full collection: every 60 minutes (was 6h)
COLLECTION_SCHEDULE_CRON="0 * * * *"
# Mini top-up collection: every 15 min (fast sources only, ~1000 jobs)
MINI_COLLECTION_SCHEDULE_CRON="*/15 * * * *"
# Default target jobs per full collection run
COLLECTION_RUN_LIMIT=5000
# Boosted limit when 2h-backlog is low (adaptive catch-up)
COLLECTION_RUN_LIMIT_HIGH=12000

DEDUP_SCHEDULE_CRON="*/15 * * * *"
EMBEDDING_BATCH_SCHEDULE="*/30 * * * *"

# ─── PIPELINE BATCH SIZES / WORKER COUNTS ────────────────────────────────────
# Tune per-service parallelism (defaults are conservative; raise on big boxes)
CLEANER_BATCH_SIZE=150
CLEANER_WORKERS=60

DEDUP_BATCH_SIZE=200
DEDUP_WORKERS=40

ENRICHER_BATCH_SIZE=120
ENRICHER_WORKERS=50

VERIFIER_BATCH_SIZE=180
VERIFIER_WORKERS=70

EMBEDDER_BATCH_SIZE=96
EMBEDDER_DB_WORKERS=40

# ─── FEATURE FLAGS ───────────────────────────────────────────────────────────
FEATURE_SCAM_DETECTION=true
FEATURE_AUTHENTICITY_CHECK=true
FEATURE_SKILL_EXTRACTION=true
FEATURE_SALARY_ESTIMATION=true
FEATURE_EMBEDDINGS=true
FEATURE_RECOMMENDATIONS=true
FEATURE_NOTIFICATIONS=true
FEATURE_FEEDBACK_LEARNING=false
