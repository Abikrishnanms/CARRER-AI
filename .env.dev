# =============================================================================
# AI-Powered Job Intelligence Platform — Local Development Overrides
# Copy this file to .env or source it before docker compose up
# These values override .env.example for laptop/development environments.
# =============================================================================

# ─── APPLICATION ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ─── PIPELINE BATCH SIZES / WORKER COUNTS ────────────────────────────────────
# Drastically reduced for laptop/development to avoid 100% CPU
CLEANER_BATCH_SIZE=50
CLEANER_WORKERS=8

DEDUP_BATCH_SIZE=100
DEDUP_WORKERS=6

ENRICHER_BATCH_SIZE=60
ENRICHER_WORKERS=6

VERIFIER_BATCH_SIZE=80
VERIFIER_WORKERS=8
VERIFIER_CHECK_URLS=false
VERIFIER_HTTP_CONCURRENCY=6

EMBEDDER_BATCH_SIZE=32
EMBEDDER_DB_WORKERS=4

# ─── COLLECTION CADENCE ──────────────────────────────────────────────────────
# Less aggressive on laptop
COLLECTION_RUN_LIMIT=500
COLLECTION_RUN_LIMIT_HIGH=1000

# ─── SCHEDULER INTERVALS ─────────────────────────────────────────────────────
# Slower intervals for local dev
ANALYTICS_REFRESH_INTERVAL_MINUTES=60
ORCHESTRATOR_ENABLED=false

# ─── KAFKA ───────────────────────────────────────────────────────────────────
KAFKA_SEND_CONCURRENCY=10

# ─── EMBEDDER ────────────────────────────────────────────────────────────────
# Limit thread contention on CPU-only machines
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

# ─── MONGO ───────────────────────────────────────────────────────────────────
MONGO_MAX_POOL_SIZE=50
